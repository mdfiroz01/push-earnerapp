{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com')",
        "fcmTokens": {
          "$tokenKey": {
            ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com')",
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com')"
          }
        }
      }
    },
    "deposits": {
      ".read": "auth != null",
      "$depId": {
        ".write": "auth != null"
      }
    },
    "withdraws": {
      ".read": "auth != null",
      "$widId": {
        ".write": "auth != null"
      }
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    },
    "plans": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_tasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notices": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    },
    "slider": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@gmail.com'"
    }
  }
}